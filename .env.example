# Expo (mobile) - variables publiques (préfixe EXPO_PUBLIC_*)
# Ne mettez jamais de clé Supabase "service_role" côté mobile.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Facultatif en développement, requis pour remonter les crashs en production.
# Créez un projet Sentry et configurez ce DSN dans l'environnement EAS de production.
EXPO_PUBLIC_SENTRY_DSN=

# Optionnel : URL publique vers la dernière APK (ex. Supabase Storage / CDN)
EXPO_PUBLIC_APK_URL=
