# Expo (mobile) - variables publiques (préfixe EXPO_PUBLIC_*)
# Ne mettez jamais de clé Supabase "service_role" côté mobile.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Store SENTRY_AUTH_TOKEN only as an EAS secret; never commit its value.

# Optionnel : URL publique vers la dernière APK (ex. Supabase Storage / CDN)
EXPO_PUBLIC_APK_URL=
