{
  "expo": {
    "name": "ImoPrestige",
    "slug": "imo-nord-togo",
    "scheme": "imonordtogo",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/kara-immo-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.imonordtogo.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Autorisez l'accès au micro pour la recherche vocale.",
        "NSSpeechRecognitionUsageDescription": "Autorisez la reconnaissance vocale pour rechercher des annonces."
      }
    },
    "updates": {
      "url": "https://u.expo.dev/7faf2828-55ef-491d-be14-b568686f71fc",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/kara-immo-icon.png",
        "backgroundColor": "#C2410C"
      },
      "package": "com.imonordtogo.app",
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "imonordtogo",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "imonordtogo",
              "host": "property"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "imonordtogo",
              "host": "reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/imoprestige-icon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos."
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/imoprestige-adaptive-icon.png",
          "color": "#087F86"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Autorisez l'accès au micro pour la recherche vocale.",
          "speechRecognitionPermission": "Autorisez la reconnaissance vocale pour rechercher des annonces.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/imoprestige-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F8F8",
          "dark": {
            "image": "./assets/imoprestige-icon.png",
            "backgroundColor": "#101B1D"
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": true,
          "style": "dark"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "contactPhone": "22893576298",
      "contactEmail": "imonordtogo@gmail.com",
      "whatsappPhone": "22893576298",
      "adminApiUrl": "https://imo-nord-togo-mobile.vercel.app",
      "apkDownloadUrl": "",
      "eas": {
        "projectId": "7faf2828-55ef-491d-be14-b568686f71fc"
      }
    },
    "owner": "josild"
  }
}
