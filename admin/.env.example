NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: Supabase secret API key (sb_secret_) or legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=
# Mot de passe administrateur maître défini sur Render pour le back-office
ADMIN_PASSWORD=
# Email administrateur (optionnel, défaut: admin@imoprestige.tg)
ADMIN_EMAIL=admin@imoprestige.tg
# Secret pour le nettoyage automatique des photos orphelines (ex: /api/internal/cleanup-property-storage)
PROPERTY_STORAGE_CLEANUP_SECRET=
